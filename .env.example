# neurox-brain configuration.
#
# Every value has a working default in `src/neurox_brain/config.py`, so running
# with no environment at all is a supported state. This file documents what can
# be changed, not what must be set.

# --- HTTP -------------------------------------------------------------------
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8000

# --- Model ------------------------------------------------------------------
# en_core_web_sm is the default, and NOT because it is smaller.
#
# The obvious upgrade is en_core_web_md for its word vectors. spaCy prunes md's
# vector table to 20,000 entries, so 26-34 vocabulary keys share each vector and
# cosine similarity between most word pairs comes out as either exactly 1.0 or an
# artefact of which bucket the two words landed in. Graded similarity is the
# whole reason to use vectors for distractors and md does not provide it.
#
# There is no parsing argument for the larger model either: md beats sm by about
# a point of dependency accuracy. So the vectors are unusable and the parse is
# not better. en_core_web_lg has real vectors (514,157 of them) and costs ~1GB
# resident, which is a whole VPS for one stage that has a WordNet-based
# alternative. Set it if you have the memory and want the similarity band.
#
# en_core_web_md is usable — everything works — but its vectors should not be
# trusted for anything semantic. See docs/operations.md.
BRAIN_SPACY_MODEL=en_core_web_sm

# --- Limits -----------------------------------------------------------------
# A cap on request size. The API's own source limit is 500k characters, but a
# single request that large is 30+ seconds of parsing, so it is worth being able
# to set this lower on a small machine.
BRAIN_MAX_TEXT_CHARS=500000

# Worker processes. Analysis is CPU-bound and single-threaded per process; scale
# by adding processes rather than threads. Should match uvicorn's --workers.
BRAIN_WORKERS=2

# --- Transport --------------------------------------------------------------
# http — the API calls this service and waits. No extra infrastructure.
# amqp — jobs arrive on a queue and results are published back. Required when a
#        document is too large to hold an HTTP connection open for.
BRAIN_TRANSPORT=http

BRAIN_AMQP_URL=amqp://neurox:neurox@localhost:5672
BRAIN_AMQP_JOB_QUEUE=brain.jobs
BRAIN_AMQP_RESULT_QUEUE=brain.results
BRAIN_AMQP_PREFETCH=1

# --- Corpus -----------------------------------------------------------------
# Where the document-frequency counts are kept. This is what makes keyword
# weights real IDF rather than term frequency wearing a hat; deleting it only
# costs the counts, which rebuild as the service is used.
BRAIN_CORPUS_PATH=./data/corpus.json

# --- Webhook (used when the API sends work with a callback URL) -------------
# Shared secret for the HMAC-SHA256 signature on every callback. Must match the
# API's value. Without it, any host that can reach the callback endpoint could
# inject a result — and a result is what writes cards into somebody's deck.
BRAIN_WEBHOOK_SECRET=change-me
